# Copy to .env and adjust. .env is gitignored.

# ---- Flask ----
# development | testing | production
# production refuses to start while SECRET_KEY is the default below.
FLASK_ENV=development

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# ---- Database ----
DATABASE_URL=sqlite:///blood_bank.db
# Echo every SQL statement to the log. Accepts: true/false, 1/0, yes/no, on/off.
SQLALCHEMY_ECHO=false

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ---- Security ----
PASSWORD_HASH_METHOD=pbkdf2:sha256
# Session lifetime in SECONDS (3600 = 1 hour).
SESSION_TIMEOUT=3600

# ---- UI ----
ITEMS_PER_PAGE=20
